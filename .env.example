# =============================================================================
# NextOps environment configuration
# Copy to .env for local `npm run dev`.
# shsdgx Image-Only Deploy: copy to `.env.prod.shsdgx` on your workstation for
# local `nerdctl build` (PUBLIC_* bake only; gitignored). Runtime secrets stay
# in the VM's `.env.prod` — never scp from laptop.
# Server-side compose: `.env.prod` on the deploy host. Never commit real secrets.
# =============================================================================

# --- Authentication (required) ---
NEXTOPS_ADMIN_USER=admin
NEXTOPS_ADMIN_PASS=changeme

# Bearer token for Tool Endpoints (/api/sites, /api/es) used by the LangGraph
# Diagnosis Orchestrator (name NEXTOPS_DIFY_TOKEN is leftover). Also used by
# the Tool Endpoint MCP Adapter if that sidecar is still deployed.
# Seeds Tool Endpoint Token into Local Settings Store on first boot (ADR-0012).
NEXTOPS_DIFY_TOKEN=changeme-dify-token

# --- Tool Endpoint MCP Adapter (ADR-0015; sidecar / local `mcp-adapter`) ---
# NEXTOPS_TOOL_BASE=http://127.0.0.1:3000
# MCP_HOST=0.0.0.0
# MCP_PORT=3100
# MCP_ALLOWED_HOSTS=
# MCP_FETCH_TIMEOUT_MS=30000

# --- LangGraph Diagnosis Orchestrator sidecar (ADR-0016 / ADR-0023) ---
# Local / Helm same-pod: http://127.0.0.1:3200
# nerdctl run (separate containers): http://nextops-orchestrator:3200
# ORCH_BASE_URL=http://127.0.0.1:3200
# ORCH_HOST=0.0.0.0
# ORCH_PORT=3200
# ORCH_FETCH_TIMEOUT_MS=180000
# ORCH_DATA_DIR=.data
# AIBRIDGE_BASE_URL=https://aiot.corp.example.com/gemini-ct
# AIBRIDGE_MODEL=gemini-2.5-flash-lite
# AIBRIDGE_EMPLOYEE_ID=nextops+pJTgxIYAFUlNW4XlLTaeg

# --- Image allowlist (Assistant Images in OPSGPT) ---
# Comma-separated hostnames. The hostname from AIBRIDGE_BASE_URL is also included.
# NEXTOPS_IMAGE_ALLOWLIST=cdn.example.com,img.ops.local

# --- Elasticsearch (required for logs and ES query tools) ---
ES_BASE_URL=http://elasticsearch:9200
# Site log indices: {LOG_INDEX_PREFIX}-{factoryCode}-* (ADR-0013)
# Example resolved pattern for 龍華: logs-lh-*
LOG_INDEX_PREFIX=logs

# --- System Behavior Tracking (optional; backend request telemetry) ---
SYSTEM_BEHAVIOR_TRACKING_ENABLED=false
SYSTEM_BEHAVIOR_TRACKING_PERSIST_ES_ENABLED=false
SYSTEM_BEHAVIOR_TRACKING_ES_INDEX_PREFIX=nextops-system-tracking
SYSTEM_BEHAVIOR_TRACKING_QUEUE_MAX=5000
# Optional stable runtime identity for multi-instance deployments
# NEXTOPS_INSTANCE_ID=nextops-prod-a1
# Optional JSON overrides:
# SYSTEM_BEHAVIOR_TRACKING_ROUTE_OVERRIDES={"include":["/api"],"exclude":["/api/auth"],"bodyCaptureAllowlist":["/api/logs/stream","/api/es/query","/api/diagnosis","/api/sites/"]}

# --- Prometheus (global dashboard KPIs) ---
PUBLIC_DEFAULT_PROMETHEUS_URL=http://prometheus:9090

# --- 雲平台服務點檢報告 (daily-check-report sidecar, port 3300) ---
# NextOps proxies /api/daily-check/* to this base. Compose uses the service DNS name.
# DAILY_CHECK_BASE_URL=http://127.0.0.1:3300
# DAILY_CHECK_PORT=3300
# DAILY_CHECK_OUT_DIR=./out
# Production Prometheus URL for the Python service. Compose sets PROMETHEUS_URL from
# PUBLIC_DEFAULT_PROMETHEUS_URL. Do not point this at a mock in production.
# PROMETHEUS_URL=http://prometheus:9090
# Gmail / Google Chat are env-only. Leave unset to keep 寄送 buttons from delivering.
# GMAIL_SA_KEY_FILE=
# GMAIL_DELEGATED_USER=
# GMAIL_OAUTH_TOKEN_FILE=
# GMAIL_FROM=
# GMAIL_TO=
# GOOGLE_CHAT_WEBHOOK_URL=
# REPORT_PUBLIC_BASE_URL=
# CHAT_OAUTH_TOKEN_FILE=
# GOOGLE_CHAT_SPACE=

# --- Elasticsearch credentials (optional; used for Basic auth) ---
PUBLIC_DEFAULT_ELASTICSEARCH_URL=http://elasticsearch:9200
PUBLIC_DEFAULT_ELASTICSEARCH_USER=
PUBLIC_DEFAULT_ELASTICSEARCH_PASSWORD=

# --- HTTP proxy for upstream fetch (Prometheus, ES) ---
# Production / .env.prod: Direct Upstream Access is **applied** at deploy (ADR-0019),
# not only as a template default. Leftover true is rewritten unless that switch is
# explicitly opted in. Build-time HTTP_PROXY is unrelated.
#   PUBLIC_DEFAULT_PROXY_ENABLED=false
#   PUBLIC_MYSQL_PROXY_ENABLED=false
# Startup still warns if NODE_ENV=production and fetch proxy is on; it does not hard-fail.
#
# Local laptop .env (optional exception — not production):
# PUBLIC_DEFAULT_PROXY_ENABLED=true
# PUBLIC_DEFAULT_PROXY_HOST=192.0.2.1
# PUBLIC_DEFAULT_PROXY_PORT=808
# PUBLIC_DEFAULT_PROXY_BYPASS_SITE_HOSTS=false
PUBLIC_DEFAULT_PROXY_ENABLED=false
PUBLIC_DEFAULT_PROXY_HOST=
PUBLIC_DEFAULT_PROXY_PORT=808
# When true (default), Site Prom hosts + ES_BASE_URL bypass proxy if fetch proxy is on.
# Set false on laptops so 10.x traffic routes through PUBLIC_DEFAULT_PROXY_HOST.
PUBLIC_DEFAULT_PROXY_BYPASS_SITE_HOSTS=true

# MySQL CONNECT tunnel — independent of PUBLIC_DEFAULT_PROXY_ENABLED.
# Production default false = direct TCP to DB_HOST. Turn on only when MySQL requires HTTP CONNECT.
# Admin UI: /admin/sources → mysql_proxy_enabled (runtime toggle; also settable here).
PUBLIC_MYSQL_PROXY_ENABLED=false

# --- MySQL pipeline metrics (required for dashboard pipeline KPIs and /pipelines/timeouts) ---
DB_HOST=mysql
DB_PORT=3306
DB_USER=nextops
DB_PASSWORD=changeme
DB_NAME=jenkins

# --- Robusta Store (ADR-0028; second MySQL, not DB_*) ---
# Read-only history of Robusta Investigations. Shares MySQL CONNECT with Pipeline Metrics.
# ROBUSTA_DB_NAME is the MySQL database (e.g. ai-ops), not a table name.
ROBUSTA_DB_HOST=
ROBUSTA_DB_PORT=3306
ROBUSTA_DB_USER=
ROBUSTA_DB_PASSWORD=
ROBUSTA_DB_NAME=
# Optional JSON override. Default maps five k8s_*_logs tables (cluster_id) as Investigations.
# Use investigation_step mode only if the Store has investigation + investigation_step tables:
# ROBUSTA_STORE_SCHEMA={"mode":"investigation_step","investigationTable":"investigation","stepTable":"investigation_step"}
# Live Pod Diagnostics trigger (ADR-0030). Token is the Robusta Action Token, not a task id.
ROBUSTA_ACTION_URL=
ROBUSTA_ACTION_TOKEN=

# --- SRE operator settings (NOT env vars) ---
# Dashboard refresh interval, pipeline timeout threshold, and metrics window are
# configured in the browser at /admin/dashboard and stored in localStorage.
# Server-side connection defaults below are deployment env vars only.

# --- Site configuration override (optional) ---
# JSON object keyed by site title. When unset, src/lib/site-config.json is used.
# NEXTOPS_SITES_CONFIG={"龍華-生產":{"queryUrl":"http://prometheus:9090","alertsUrl":"http://alertmanager:9093/api/v1/alerts","clusterTag":"lh-k8s-cluster"}}

# --- Node / SvelteKit adapter-node ---
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Public URL the browser uses. Required for correct session cookies with adapter-node.
# Omitting ORIGIN makes adapter-node assume https and issue Secure cookies; browsers
# will not store those over plain HTTP (e.g. http://10.x.x.x:3003).
# ORIGIN is scheme+host only — no path (ADR-0035). Shared-host HTTPS:
# ORIGIN=https://tmdev.corp.example.com
# ORIGIN=http://192.0.2.2:3003
# ORIGIN=https://nextops.example.com
#
# Bake-time Public Base Path (SvelteKit paths.base). Empty = app at / (laptop,
# dedicated host). shsdgx shared host must bake /nextops into the image.
# Changing prefix requires a new image. Nginx must forward /nextops/… without stripping.
# PUBLIC_BASE_PATH=/nextops
PUBLIC_BASE_PATH=
